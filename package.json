{
  "name": "wild-rivers-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=.sim.mjs && node .sim.mjs",
    "test:presentation": "esbuild scripts/verify-presentation.ts --bundle --platform=node --format=esm --outfile=.tools/presentation-check.mjs && node .tools/presentation-check.mjs",
    "test:ui": "node scripts/verify-ui-v3.mjs",
    "test:content": "esbuild scripts/verify-content.ts --bundle --platform=node --format=esm --outfile=.tools/content-check.mjs && node .tools/content-check.mjs"
  },
  "dependencies": {
    "motion": "^13.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
